class_name InteriorManager
extends Node
## Enterable buildings: door triggers on every placed special that has an interior, a
## short fade, and one interior scene loaded at a time. The city keeps simulating outside.
##
## Wiring (main.gd, after the City and StreetMode exist):
##     var interiors := InteriorManager.new()
##     add_child(interiors)
##     interiors.setup(city, street)
##
## Doors appear and disappear with City.building_added / building_removed, using the
## door spots in interiors/special_doors.gd (generated by art/tools/build_specials.py).
## Missions and quests can also call enter() / exit() directly, and listen to
## interior_entered / interior_exited. Points of interest: current.marker("vault").

signal interior_entered(interior_id: String, building: Dictionary)
signal interior_exited(interior_id: String, building: Dictionary)

# Rooms load high above the map, out of view. Not below it: the street ground is an
# infinite WorldBoundary plane at y = 0 that pushes anything under it back up.
const ORIGIN := Vector3(0.0, 2500.0, 0.0)
const DOOR_DATA := preload("res://interiors/special_doors.gd")

@export var fade_seconds := 0.35
@export var indoor_camera_distance := 2.6

## Optional: func(interior_id: String, building: Dictionary) -> bool. Return false to keep the
## door shut (a mission locking the bank, say). Missions set it; nobody else needs to.
var can_enter: Callable

var city: City
var street: StreetMode
var current: Interior = null
var current_id := ""
var current_building := {}
var busy := false
var doors := {}                 # building id -> DoorTrigger

var _layer: CanvasLayer
var _fade: ColorRect
var _title: Label
var _door: DoorTrigger = null   # the door used to come in (to go back out of)
var _saved_env: Environment
var _saved_distance := 0.0
var _sun_masks := {}            # DirectionalLight3D -> original cull mask
var _env: Environment
var _return_to := Transform3D()


func _ready() -> void:
	_layer = CanvasLayer.new()
	_layer.layer = 90
	add_child(_layer)
	_fade = ColorRect.new()
	_fade.color = Color(0, 0, 0, 0)
	_fade.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_fade.set_anchors_preset(Control.PRESET_FULL_RECT)
	_layer.add_child(_fade)
	_title = Label.new()
	_title.set_anchors_preset(Control.PRESET_CENTER_TOP)
	_title.position.y = 60
	_title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_title.add_theme_font_size_override("font_size", 30)
	_title.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.85))
	_title.add_theme_constant_override("outline_size", 8)
	_title.modulate.a = 0.0
	_layer.add_child(_title)
	_env = _make_env()


func setup(c: City, s: StreetMode) -> void:
	city = c
	street = s
	city.building_added.connect(func(id: int, _a: bool) -> void: _sync_door(id))
	city.building_removed.connect(_remove_door)
	for id in city.buildings:
		_sync_door(id)


# ------------------------------------------------------------------- doors ---

static func door_info(kind: String) -> Dictionary:
	## {interior, door: Vector3 (model-local), name} for an enterable special, else {}.
	return DOOR_DATA.DOORS.get(kind, {})


func door_transform(b: Dictionary) -> Transform3D:
	## World transform of a building's doorway: origin on the facade, +Z out to the street.
	var info := door_info(String(b.get("kind", "")))
	var basis := Basis(Vector3.UP, int(b.get("rot", 0)) * PI * 0.5)
	var local: Vector3 = info.get("door", Vector3.ZERO)
	# Street collision blocks a special's lot inside (half - 1.4) m (CityCollision), so
	# a door set back behind that line moves out to it, where the player can reach it.
	local.z = maxf(local.z, int(b.get("size", 1)) * City.TILE * 0.5 - 1.4)
	return Transform3D(basis, city.building_center(b) + basis * local)


func _sync_door(id: int) -> void:
	_remove_door(id)
	var b: Dictionary = city.buildings.get(id, {})
	var info := door_info(String(b.get("kind", "")))
	if info.is_empty() or not Interior.exists(info.interior):
		return
	var d := DoorTrigger.new()
	d.name = "Door_%d" % id
	d.interior_id = info.interior
	d.building_id = id
	d.label = String(b.get("name", info.get("name", "")))
	var xf := door_transform(b)
	d.transform = xf
	d.outside = Transform3D(xf.basis, xf.origin + xf.basis.z * 2.2)
	d.entered_by_player.connect(_on_door)
	add_child(d)
	doors[id] = d


func add_door(xf: Transform3D, interior_id: String, label := "") -> DoorTrigger:
	## A door that isn't on a catalog special, e.g. the Resident's home in a zone building.
	## xf: origin on the facade, +Z pointing out to the street. Free it to remove the door.
	var d := DoorTrigger.new()
	d.name = "Door_" + interior_id
	d.interior_id = interior_id
	d.label = label
	d.transform = xf
	d.outside = Transform3D(xf.basis, xf.origin + xf.basis.z * 2.2)
	d.entered_by_player.connect(_on_door)
	add_child(d)
	return d


func _remove_door(id: int) -> void:
	if doors.has(id):
		doors[id].queue_free()
		doors.erase(id)


func _on_door(d: DoorTrigger) -> void:
	if busy or current or not street or not street.active or street.car or street.busy or street.down:
		return
	enter(d.interior_id, d)


# -------------------------------------------------------------- enter/exit ---

func enter(interior_id: String, door: DoorTrigger = null, at_marker := "spawn") -> bool:
	## Fade out, load the room, put the player at a marker (its spawn by default; "busted"
	## in the police station puts them by the cells), fade in. Without a door, exit()
	## returns the player to where they were standing.
	if busy or current or not Interior.exists(interior_id):
		return false
	var b: Dictionary = city.buildings.get(door.building_id, {}) if door and city else {}
	if can_enter.is_valid() and not can_enter.call(interior_id, b):
		return false
	busy = true
	_door = door
	_return_to = street.player.global_transform
	street.player.set_controls(false)
	await _fade_to(1.0)
	current = Interior.create(interior_id)
	current.position = ORIGIN
	add_child(current)
	current.exit_requested.connect(func() -> void: exit())
	current_id = interior_id
	current_building = b
	_go_indoors(true)
	var mk := current.marker(at_marker)
	var sp: Transform3D = mk.global_transform if mk else current.spawn_transform()
	var f := -sp.basis.z
	street.player.place(sp.origin + Vector3.UP * 0.05, atan2(-f.x, -f.z))
	current.arm_exit_after(0.6)
	_title.text = door.label if door else ""
	await _fade_to(0.0)
	street.player.set_controls(true)
	busy = false
	_show_title()
	interior_entered.emit(interior_id, b)
	return true


func exit() -> void:
	## Fade out, unload the room, put the player back outside the door they came in by.
	if busy or not current:
		return
	busy = true
	street.player.set_controls(false)
	await _fade_to(1.0)
	var id := current_id
	var b := current_building
	current.queue_free()
	current = null
	current_id = ""
	current_building = {}
	_go_indoors(false)
	var out: Transform3D
	if _door and is_instance_valid(_door):
		out = _door.outside
	elif not b.is_empty():
		var xf := door_transform(b)
		out = Transform3D(xf.basis, xf.origin + xf.basis.z * 2.2)
	else:
		out = _return_to
	var f := out.basis.z   # face the street
	street.player.place(out.origin + Vector3.UP * 0.1, atan2(-f.x, -f.z))
	await _fade_to(0.0)
	street.player.set_controls(true)
	busy = false
	interior_exited.emit(id, b)


func is_inside() -> bool:
	return current != null


# ----------------------------------------------------------------- helpers ---

func _go_indoors(on: bool) -> void:
	var cam := street.camera
	var rig := street.player.rig
	if on:
		_saved_env = cam.environment
		cam.environment = _env
		_saved_distance = rig.distance
		rig.distance = indoor_camera_distance
		if rig.spring:
			rig.spring.spring_length = indoor_camera_distance
		# Keep the sun and moon off the room's render layer.
		for l in get_tree().root.find_children("*", "DirectionalLight3D", true, false):
			var dl := l as DirectionalLight3D
			_sun_masks[dl] = dl.light_cull_mask
			dl.light_cull_mask &= ~Interior.LAYER
	else:
		cam.environment = _saved_env
		rig.distance = _saved_distance
		if rig.spring:
			rig.spring.spring_length = _saved_distance
		for dl in _sun_masks:
			if is_instance_valid(dl):
				dl.light_cull_mask = _sun_masks[dl]
		_sun_masks.clear()
	rig.snap()


func _make_env() -> Environment:
	var e := Environment.new()
	e.background_mode = Environment.BG_COLOR
	e.background_color = Color(0.02, 0.02, 0.025)
	e.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	e.ambient_light_color = Color(0.55, 0.5, 0.45)
	e.ambient_light_energy = 0.35
	e.tonemap_mode = Environment.TONE_MAPPER_FILMIC
	e.tonemap_exposure = 1.0
	e.glow_enabled = true
	e.glow_intensity = 0.6
	e.glow_bloom = 0.05
	e.glow_hdr_threshold = 1.1
	e.ssao_enabled = true
	e.ssao_radius = 0.8
	e.ssao_intensity = 1.6
	return e


func _fade_to(a: float) -> void:
	var tw := create_tween()
	tw.tween_property(_fade, "color:a", a, fade_seconds)
	await tw.finished


func _show_title() -> void:
	if _title.text == "":
		return
	var tw := create_tween()
	tw.tween_property(_title, "modulate:a", 1.0, 0.3)
	tw.tween_interval(1.8)
	tw.tween_property(_title, "modulate:a", 0.0, 0.6)
